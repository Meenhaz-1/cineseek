# Copy this file to .env.local and fill values only in that ignored file.
# Never put real credentials in this example.
# Public Vercel portfolio mode disables persistent writes and AI requests.
CINESEEK_DEPLOYMENT_MODE=local
NEXT_PUBLIC_CINESEEK_DEPLOYMENT_MODE=local

# Used only for publishing or fetching an immutable private Vercel Blob release.
CINESEEK_DATA_RELEASE=
BLOB_READ_WRITE_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# Prefer a TMDB v4 API read access token:
TMDB_READ_TOKEN=

# Or use a TMDB v3 API key instead:
# TMDB_API_KEY=
